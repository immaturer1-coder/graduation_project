<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5", data: { turbo: false } }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="space-y-1.5">
    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest ml-1">New password</label>
    <% if @minimum_password_length %>
      <em class="text-[9px] text-slate-600 ml-1">(<%= @minimum_password_length %> characters minimum)</em>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full bg-slate-950 border border-slate-800 rounded-xl py-3 px-4 focus:outline-none focus:border-indigo-500 text-sm text-white" %>
  </div>

  <div class="space-y-1.5">
    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest ml-1">Confirm new password</label>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full bg-slate-950 border border-slate-800 rounded-xl py-3 px-4 focus:outline-none focus:border-indigo-500 text-sm text-white" %>
  </div>

  <div class="pt-4">
    <%= f.submit "Change my password", class: "w-full bg-indigo-600 hover:bg-indigo-500 text-white font-black py-3.5 rounded-xl transition-all shadow-lg shadow-indigo-500/20 cursor-pointer active:scale-[0.98] border-none text-sm" %>
  </div>
<% end %>

<div class="mt-6 text-center">
  <%= render "devise/shared/links" %>
</div>
