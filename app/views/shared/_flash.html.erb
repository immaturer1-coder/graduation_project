<%# app/views/shared/_flash.html.erb %>
<div id="flash-container" class="fixed top-4 z-[9999] pointer-events-none" style="left: 50%; transform: translateX(-50%); width: max-content; max-width: 90vw;">
  <% flash.each_with_index do |(type, message), index| %>
    <div id="flash-item-<%= index %>" class="pointer-events-auto animate-in fade-in slide-in-from-top-4 duration-300 transition-opacity opacity-100 mb-2">
      <% if type == "notice" || type == "success" %>
        <div class="bg-indigo-600/90 backdrop-blur-md border border-indigo-400/50 text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="text-base font-bold whitespace-nowrap"><%= message %></span>
        </div>
      <% elsif type == "alert" || type == "error" %>
        <div class="bg-rose-600/90 backdrop-blur-md border border-rose-400/50 text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
          <span class="text-base font-bold whitespace-nowrap"><%= message %></span>
        </div>
      <% end %>
    </div>
    
    <script>
      setTimeout(function() {
        var el = document.getElementById('flash-item-<%= index %>');
        if (el) {
          el.classList.remove('opacity-100');
          el.classList.add('opacity-0');
          setTimeout(function() { el.remove(); }, 300);
        }
      }, 5000);
    </script>
  <% end %>
</div>